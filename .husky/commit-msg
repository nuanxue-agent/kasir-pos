#!/bin/sh
# Enforce conventional commit format
# Allowed: feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert
commit_regex='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\(.+\))?: .{1,100}'
commit_msg=$(cat "$1")

if ! echo "$commit_msg" | grep -qE "$commit_regex"; then
  echo ""
  echo "❌  Invalid commit message format."
  echo ""
  echo "   Expected: <type>(<scope>): <description>"
  echo "   Types: feat | fix | docs | style | refactor | perf | test | chore | ci | build | revert"
  echo ""
  echo "   Examples:"
  echo "     feat: add bundle pricing to POS"
  echo "     fix(cart): prevent negative quantity"
  echo "     chore: update dependencies"
  echo ""
  echo "   Your message: $commit_msg"
  echo ""
  exit 1
fi
