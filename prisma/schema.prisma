generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// schema continues below...
// PLATFORM LEVEL
// ─────────────────────────────────────────────────────────────────────────────

model Plan {
  id              String   @id @default(cuid())
  name            String   @unique  // FREE, PRO, ENTERPRISE
  maxStores       Int      @default(1)
  maxStaff        Int      @default(1)
  maxProducts     Int      @default(100)
  hasAdvancedReports Boolean @default(false)
  hasLoyalty      Boolean  @default(false)
  hasApi          Boolean  @default(false)
  priceMonthly    Float    @default(0)
  priceYearly     Float    @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  tenants         Tenant[]
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique   // used in URLs
  email       String       @unique
  phone       String?
  logo        String?
  planId      String
  plan        Plan         @relation(fields: [planId], references: [id])
  status      TenantStatus @default(TRIAL)
  trialEndsAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  stores      Store[]
  users       User[]
  dbConfig    DbConfig?
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

// Per-tenant DB config (SQLite/Postgres/Supabase)
model DbConfig {
  id         String     @id @default(cuid())
  tenantId   String     @unique
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider   DbProvider @default(SQLITE)
  url        String?    // for postgres/supabase
  updatedAt  DateTime   @updatedAt
}

enum DbProvider {
  SQLITE
  POSTGRESQL
  SUPABASE
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?   // hashed
  pin           String?   // hashed, for quick POS switch
  image         String?
  role          UserRole  @default(CASHIER)
  active        Boolean   @default(true)
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  storeAccess   StoreUser[]
  orders        Order[]
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  CASHIER
}

// next-auth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE LEVEL
// ─────────────────────────────────────────────────────────────────────────────

model Store {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  phone      String?
  email      String?
  taxRate    Float       @default(0)
  currency   String      @default("IDR")
  receiptNote String?
  timezone   String      @default("Asia/Jakarta")
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  staff      StoreUser[]
  categories Category[]
  products   Product[]
  orders     Order[]
  customers  Customer[]
  discounts  Discount[]
}

// Many-to-many: User ↔ Store with role override
model StoreUser {
  id      String    @id @default(cuid())
  storeId String
  store   Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    UserRole  @default(CASHIER)

  @@unique([storeId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  icon      String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String      @id @default(cuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  sku         String?
  barcode     String?
  price       Float
  cost        Float       @default(0)
  image       String?
  trackStock  Boolean     @default(true)
  stock       Int         @default(0)
  lowStock    Int         @default(5)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  variants    Variant[]
  orderItems  OrderItem[]
  stockLogs   StockLog[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  price      Float?
  stock      Int         @default(0)
  active     Boolean     @default(true)
  orderItems OrderItem[]
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@unique([storeId, phone])
  @@unique([storeId, email])
}

// ─────────────────────────────────────────────────────────────────────────────
// DISCOUNTS
// ─────────────────────────────────────────────────────────────────────────────

model Discount {
  id         String       @id @default(cuid())
  storeId    String
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  code       String?      // coupon code, null = auto-apply
  type       DiscountType
  value      Float        // percent or fixed amount
  minOrder   Float        @default(0)
  maxUses    Int?
  usedCount  Int          @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  orders     Order[]

  @@unique([storeId, code])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id           String      @id @default(cuid())
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id])
  number       String
  status       OrderStatus @default(PENDING)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  discountId   String?
  discount     Discount?   @relation(fields: [discountId], references: [id])
  items        OrderItem[]
  subtotal     Float
  discountAmt  Float       @default(0)
  taxAmt       Float       @default(0)
  total        Float
  payments     Payment[]
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([storeId, number])
}

enum OrderStatus {
  PENDING
  PAID
  VOIDED
  REFUNDED
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])
  name      String   // snapshot
  variantName String?
  price     Float    // snapshot
  qty       Int
  discount  Float    @default(0)
  subtotal  Float
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Float
  reference String?
  change    Float         @default(0)
  createdAt DateTime      @default(now())
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QRIS
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────────────────────────────────────

model StockLog {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  type      StockLogType
  qty       Int
  note      String?
  createdAt DateTime     @default(now())
}

enum StockLogType {
  SALE
  ADJUSTMENT
  RESTOCK
  VOID
  INITIAL
}
